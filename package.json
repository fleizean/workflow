{
    "name": "workflow-timer",
    "version": "1.2.1",
    "description": "Workflow - Modern work tracking desktop application",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "install-electron && electron-vite dev",
        "start": "install-electron && electron-vite preview",
        "lint": "eslint .",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "test": "vitest run",
        "test:watch": "vitest",
        "baseline:capture": "node tools/baseline/capture.mjs",
        "build": "npm run typecheck && electron-vite build",
        "build:unpack": "npm run build && electron-builder --dir --publish never",
        "build:win": "npm run build && electron-builder --win --x64 --publish never",
        "build:win:arm64": "npm run build && electron-builder --win --arm64 --publish never",
        "build:mac": "npm run build && electron-builder --mac --x64 --publish never",
        "build:mac:arm64": "npm run build && electron-builder --mac --arm64 --publish never",
        "smoke:packaged": "node tools/smoke-packaged.mjs"
    },
    "keywords": [
        "timer",
        "productivity",
        "work",
        "tracker"
    ],
    "author": "Workflow Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/fleizean/workflow.git"
    },
    "bugs": {
        "url": "https://github.com/fleizean/workflow/issues"
    },
    "homepage": "https://github.com/fleizean/workflow#readme",
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@fontsource-variable/inter": "^5.3.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.3",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^24.10.1",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^5.2.0",
        "electron": "^44.2.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.2",
        "globals": "^16.5.0",
        "material-symbols": "^0.47.1",
        "playwright-core": "1.63.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.3",
        "tailwindcss": "^4.3.3",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.69.0",
        "vite": "^7.3.6",
        "vitest": "^5.0.0",
        "zod": "^4.5.4"
    },
    "dependencies": {
        "better-sqlite3": "13.0.3"
    }
}
